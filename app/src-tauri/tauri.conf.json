{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Salonera",
  "version": "0.1.0",
  "identifier": "com.salonera.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Salonera",
        "maximized": true,
        "minWidth": 1100,
        "minHeight": 700,
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Salonera",
    "shortDescription": "Düğün salonu yönetimi",
    "windows": {
      "nsis": {
        "languages": [
          "Turkish"
        ],
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
