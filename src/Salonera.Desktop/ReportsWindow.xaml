<Window x:Class="Salonera.Desktop.ReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ön Muhasebe ve Raporlar" Width="1200" Height="760" MinWidth="950" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="{StaticResource PageBrush}" Loaded="WindowLoaded">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock FontSize="24" FontWeight="SemiBold" Text="Ön Muhasebe ve Raporlar" />
        <WrapPanel Grid.Row="1" Margin="0,16,0,8">
            <StackPanel Width="240" Margin="0,0,10,8">
                <TextBlock Text="Rapor" />
                <ComboBox Height="34" ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" DisplayMemberPath="Name" />
            </StackPanel>
            <StackPanel Width="145" Margin="0,0,10,8">
                <TextBlock Text="Başlangıç" />
                <DatePicker SelectedDate="{Binding From}" />
            </StackPanel>
            <StackPanel Width="145" Margin="0,0,10,8">
                <TextBlock Text="Bitiş" />
                <DatePicker SelectedDate="{Binding To}" />
            </StackPanel>
            <StackPanel Width="170" Margin="0,0,10,8">
                <TextBlock Text="Salon (isteğe bağlı)" />
                <ComboBox Height="34" ItemsSource="{Binding Halls}" SelectedItem="{Binding Hall}" IsEnabled="{Binding CanFilterHall}"
                          DisplayMemberPath="Name" IsEditable="False" />
            </StackPanel>
            <StackPanel Width="170" Margin="0,0,10,8">
                <TextBlock Text="Müşteri (isteğe bağlı)" />
                <ComboBox Height="34" ItemsSource="{Binding Customers}" SelectedItem="{Binding Customer}" IsEnabled="{Binding CanFilterCustomer}"
                          DisplayMemberPath="FullName" />
            </StackPanel>
            <StackPanel Width="170" Margin="0,0,10,8">
                <TextBlock Text="Tedarikçi (isteğe bağlı)" />
                <ComboBox Height="34" ItemsSource="{Binding Suppliers}" SelectedItem="{Binding Supplier}" IsEnabled="{Binding CanFilterSupplier}"
                          DisplayMemberPath="Name" />
            </StackPanel>
        </WrapPanel>
        <DockPanel Grid.Row="2" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Width="90" Margin="4,0" Padding="8,5" Content="CSV" Tag=".csv" Click="ExportClick" />
                <Button Width="90" Margin="4,0" Padding="8,5" Content="Excel" Tag=".xlsx" Click="ExportClick" />
                <Button Width="90" Margin="4,0" Padding="8,5" Content="PDF" Tag=".pdf" Click="ExportClick" />
            </StackPanel>
            <Button DockPanel.Dock="Left" Width="130" Padding="9,5" Content="Raporu Getir" Click="RefreshClick" />
            <Button DockPanel.Dock="Left" Width="130" Margin="8,0,0,0" Padding="9,5"
                    Content="Filtreleri Temizle" Click="ClearFiltersClick" />
        </DockPanel>
        <Grid Grid.Row="3">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding Title}" />
            <DataGrid Grid.Row="1" Margin="0,10" ItemsSource="{Binding TableView}"
                      AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" />
            <TextBlock Grid.Row="2" Text="{Binding Note}" TextWrapping="Wrap" Foreground="#64748B" />
        </Grid>
        <TextBlock Grid.Row="4" Margin="0,12,0,0" Text="{Binding Message}"
                   TextWrapping="Wrap" Foreground="#475569" />
    </Grid>
</Window>
