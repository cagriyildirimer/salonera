<Window x:Class="Salonera.Desktop.PaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tahsilatlar" Width="1150" Height="760" MinWidth="940" MinHeight="650"
        WindowStartupLocation="CenterOwner" Background="{StaticResource PageBrush}"
        Loaded="WindowLoaded">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel>
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="Tahsilatlar ve Taksitler" />
            <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Padding="14,7"
                    Content="Yenile" Click="RefreshClick" />
        </DockPanel>
        <Grid Grid.Row="1" Margin="0,16,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,10,0">
                <TextBlock FontWeight="SemiBold" Text="Sözleşme" />
                <ComboBox Height="35" ItemsSource="{Binding Contracts}" SelectedItem="{Binding SelectedContract}"
                          SelectionChanged="ContractChanged">
                    <ComboBox.ItemTemplate><DataTemplate>
                        <TextBlock><Run Text="{Binding ContractNumber}" /><Run Text=" · " /><Run Text="{Binding CustomerName}" /></TextBlock>
                    </DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="8,0"><TextBlock Text="Sözleşme" Foreground="#64748B" /><TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Total}" /></StackPanel>
            <StackPanel Grid.Column="2" Margin="8,0"><TextBlock Text="Tahsil edilen" Foreground="#64748B" /><TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Collected}" /></StackPanel>
            <StackPanel Grid.Column="3" Margin="8,0"><TextBlock Text="İade edilen" Foreground="#64748B" /><TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Refunded}" /></StackPanel>
            <StackPanel Grid.Column="4" Margin="8,0"><TextBlock Text="Kalan borç" Foreground="#64748B" /><TextBlock FontSize="18" FontWeight="Bold" Foreground="#1D4ED8" Text="{Binding Remaining}" /></StackPanel>
        </Grid>
        <TabControl Grid.Row="2">
            <TabItem Header="Tahsilat ve Makbuz">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <DataGrid ItemsSource="{Binding Receipts}" SelectedItem="{Binding SelectedReceipt}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Makbuz" Binding="{Binding ReceiptNumber}" Width="2*" />
                            <DataGridTextColumn Header="Tarih" Binding="{Binding CollectedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="*" />
                            <DataGridTextColumn Header="Tutar" Binding="{Binding Amount, StringFormat=N2}" Width="*" />
                            <DataGridTextColumn Header="İade" Binding="{Binding Refunded, StringFormat=N2}" Width="*" />
                            <DataGridTextColumn Header="Yöntem" Binding="{Binding MethodText}" Width="*" />
                            <DataGridCheckBoxColumn Header="İptal" Binding="{Binding IsCancelled}" Width="70" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <ScrollViewer Grid.Column="1" Margin="18,0,0,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Yeni tahsilat" />
                            <TextBlock Margin="0,12,0,4" Text="Tutar" /><TextBox Height="34" Padding="7" Text="{Binding Amount}" />
                            <TextBlock Margin="0,12,0,4" Text="Kur (TL için 1)" /><TextBox Height="34" Padding="7" Text="{Binding ExchangeRate}" />
                            <TextBlock Margin="0,12,0,4" Text="Ödeme yöntemi" /><ComboBox Height="34" ItemsSource="{Binding Methods}" SelectedItem="{Binding SelectedMethod}" DisplayMemberPath="Name" />
                            <TextBlock Margin="0,12,0,4" Text="Taksit (isteğe bağlı)" /><ComboBox Height="34" ItemsSource="{Binding Installments}" SelectedItem="{Binding SelectedInstallment}" DisplayMemberPath="DueDate" />
                            <Button Height="38" Margin="0,14,0,0" Background="{StaticResource PrimaryBrush}" Foreground="White" Content="Tahsilatı Kaydet" Click="CollectClick" />
                            <Button Height="35" Margin="0,8,0,0" Content="Seçili Makbuzu PDF Aç" Click="OpenReceiptClick" />
                            <Button Height="35" Margin="0,8,0,0" Content="Seçili Makbuzu Yazdır" Click="PrintReceiptClick" />
                            <Separator Margin="0,18" />
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="İptal / iade" />
                            <TextBlock Margin="0,12,0,4" Text="İade tutarı" /><TextBox Height="34" Padding="7" Text="{Binding RefundAmount}" />
                            <TextBlock Margin="0,12,0,4" Text="Neden" /><TextBox Height="34" Padding="7" Text="{Binding Reason}" />
                            <Button Height="35" Margin="0,10,0,0" Content="Seçili Tahsilattan İade" Click="RefundClick" />
                            <Button Height="35" Margin="0,8,0,0" Content="Seçili Tahsilatı İptal Et" Click="CancelClick" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Header="Taksit Planı">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Mevcut taksitler" />
                        <DataGrid Margin="0,10,0,0" Height="350" ItemsSource="{Binding Installments}" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Vade" Binding="{Binding DueDate}" Width="*" />
                                <DataGridTextColumn Header="Tutar" Binding="{Binding Amount, StringFormat=N2}" Width="*" />
                                <DataGridTextColumn Header="Ödenen" Binding="{Binding Paid, StringFormat=N2}" Width="*" />
                                <DataGridTextColumn Header="Durum" Binding="{Binding StatusText}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Yeni plan" />
                        <TextBlock Margin="0,5,0,12" Foreground="#64748B" TextWrapping="Wrap" Text="Kapora ve taksitleri tek tek ekleyin. Toplamları sözleşme tutarına eşit olmalı." />
                        <DockPanel>
                            <DatePicker Width="150" SelectedDate="{Binding PlanDate}" />
                            <TextBox Width="130" Margin="8,0" Padding="7" Text="{Binding PlanAmount}" ToolTip="Tutar" />
                            <Button Padding="12,5" Content="Taksit Ekle" Click="AddPlanClick" />
                        </DockPanel>
                        <DataGrid Margin="0,12,0,0" Height="245" ItemsSource="{Binding PlanDraft}" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns><DataGridTextColumn Header="Vade" Binding="{Binding DueDate}" Width="*" /><DataGridTextColumn Header="Tutar" Binding="{Binding Amount, StringFormat=N2}" Width="*" /></DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button Padding="12,6" Margin="0,0,8,0" Content="Temizle" Click="ClearPlanClick" />
                            <Button Padding="12,6" Background="{StaticResource PrimaryBrush}" Foreground="White" Content="Planı Kaydet" Click="SavePlanClick" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
        <TextBlock Grid.Row="3" Margin="0,10,0,0" Foreground="#B91C1C" Text="{Binding Message}" TextWrapping="Wrap" />
    </Grid>
</Window>
