<Window x:Class="Salonera.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Salonera"
        Width="1000"
        Height="640"
        MinWidth="800"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <DockPanel Margin="28,12" VerticalAlignment="Center">
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontWeight="SemiBold"
                           Foreground="#475569" Text="{Binding CurrentUserDisplayName}" />
                <Button DockPanel.Dock="Right" Margin="0,0,18,0" Padding="12,6"
                        Visibility="{Binding CanManageUsers, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Content="Kullanıcılar" Click="OpenUsersClick" />
                <Button DockPanel.Dock="Right" Margin="0,0,8,0" Padding="12,6"
                        Visibility="{Binding CanManageSettings, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Content="Şube ve Salonlar" Click="OpenCatalogsClick" />
                <Button DockPanel.Dock="Right" Margin="0,0,8,0" Padding="12,6"
                        Visibility="{Binding CanManageCustomers, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Content="Müşteriler" Click="OpenCustomersClick" />
                <Button DockPanel.Dock="Right" Margin="0,0,8,0" Padding="12,6"
                        Visibility="{Binding CanManageEvents, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Content="Takvim" Click="OpenCalendarClick" />
                <Button DockPanel.Dock="Right" Margin="0,0,8,0" Padding="12,6"
                        Visibility="{Binding CanManageEvents, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Content="Paket ve Sözleşme" Click="OpenSalesClick" />
                <Button DockPanel.Dock="Right" Margin="0,0,8,0" Padding="12,6"
                        Visibility="{Binding CanViewFinance, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Content="Tahsilatlar" Click="OpenPaymentsClick" />
                <StackPanel>
                <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                           Text="{Binding ApplicationName}" />
                <TextBlock FontSize="13" Foreground="#64748B" Text="{Binding Subtitle}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Margin="28" Padding="36" Background="White" CornerRadius="12">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="76" Height="76" Background="#DBEAFE" CornerRadius="38">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="32" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"
                               Text="S" />
                </Border>
                <TextBlock Margin="0,20,0,6" FontSize="22" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" Text="Salonera hazır" />
                <TextBlock MaxWidth="560" TextAlignment="Center" TextWrapping="Wrap"
                           FontSize="14" Foreground="#64748B"
                           Text="Müşterileri, takvimi, sözleşmeleri ve tahsilatları üst menüden yönetebilirsiniz." />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Padding="20,0" Background="#172033">
            <DockPanel VerticalAlignment="Center">
                <TextBlock Foreground="#86EFAC" Text="●" />
                <TextBlock Margin="7,0,0,0" Foreground="White" Text="{Binding StatusText}" />
                <TextBlock DockPanel.Dock="Right" Foreground="#CBD5E1" Text="{Binding StartupTime}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
