<Window x:Class="Salonera.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Salonera" Width="1100" Height="700" MinWidth="860" MinHeight="580"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PageBrush}">
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Height" Value="43" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="#26344C" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Background="#172033">
            <DockPanel Margin="16,20">
                <StackPanel DockPanel.Dock="Top" Margin="8,0,8,26">
                    <TextBlock FontSize="26" FontWeight="Bold" Foreground="White" Text="Salonera" />
                    <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="#CBD5E1" Text="Salon Yönetimi" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Margin="12,0,0,10" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" Text="İŞLEMLER" />
                        <Button Style="{StaticResource NavButton}" Content="Müşteriler" Click="OpenCustomersClick"
                                Visibility="{Binding CanManageCustomers, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button Style="{StaticResource NavButton}" Content="Takvim ve Organizasyonlar" Click="OpenCalendarClick"
                                Visibility="{Binding CanManageEvents, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button Style="{StaticResource NavButton}" Content="Paket ve Sözleşmeler" Click="OpenSalesClick"
                                Visibility="{Binding CanManageEvents, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button Style="{StaticResource NavButton}" Content="Tahsilatlar" Click="OpenPaymentsClick"
                                Visibility="{Binding CanViewFinance, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button Style="{StaticResource NavButton}" Content="Finans ve Cari Hesaplar" Click="OpenFinanceClick"
                                Visibility="{Binding CanViewFinance, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button Style="{StaticResource NavButton}" Content="Ön Muhasebe ve Raporlar" Click="OpenReportsClick"
                                Visibility="{Binding CanViewFinance, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Separator Margin="8,18" Background="#475569" />
                        <TextBlock Margin="12,0,0,10" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" Text="YÖNETİM" />
                        <Button Style="{StaticResource NavButton}" Content="Şube ve Salonlar" Click="OpenCatalogsClick"
                                Visibility="{Binding CanManageSettings, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button Style="{StaticResource NavButton}" Content="Kullanıcılar" Click="OpenUsersClick"
                                Visibility="{Binding CanManageUsers, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="66" /><RowDefinition Height="*" /><RowDefinition Height="35" /></Grid.RowDefinitions>
            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                <DockPanel Margin="24,0" VerticalAlignment="Center">
                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#475569"
                               FontWeight="SemiBold" Text="{Binding CurrentUserDisplayName}" />
                    <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="Genel Bakış" />
                </DockPanel>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32">
                    <TextBlock FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                               Text="Salonera'ya hoş geldiniz" />
                    <TextBlock Margin="0,8,0,24" FontSize="14" Foreground="#64748B" TextWrapping="Wrap"
                               Text="İşlemlere soldaki menüden ulaşabilirsiniz. Yeni bir organizasyon için aşağıdaki sırayı izleyin." />
                    <Border Padding="24" Background="White" CornerRadius="12">
                        <StackPanel>
                            <TextBlock FontSize="17" FontWeight="SemiBold" Text="Yeni organizasyon akışı" />
                            <TextBlock Margin="0,16,0,0" Text="1   Müşteriyi kaydedin" FontSize="14" />
                            <TextBlock Margin="0,12,0,0" Text="2   Takvimde salon ve tarih seçin" FontSize="14" />
                            <TextBlock Margin="0,12,0,0" Text="3   Paket seçip sözleşme oluşturun" FontSize="14" />
                            <TextBlock Margin="0,12,0,0" Text="4   Kapora veya taksit tahsil edin" FontSize="14" />
                            <TextBlock Margin="0,12,0,0" Text="5   Giderleri ve tedarikçi ödemelerini Finanstan izleyin" FontSize="14" />
                        </StackPanel>
                    </Border>
                    <Border Margin="0,18,0,0" Padding="20" Background="#EFF6FF" CornerRadius="10">
                        <TextBlock TextWrapping="Wrap" Foreground="#1E3A8A"
                                   Text="Finans ekranında kasa ve banka hesaplarını, gelir-gider kayıtlarını, tedarikçi carisini ve organizasyon maliyetlerini görebilirsiniz." />
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                <DockPanel Margin="22,0" VerticalAlignment="Center">
                    <TextBlock DockPanel.Dock="Right" Foreground="#64748B" Text="{Binding StartupTime}" />
                    <TextBlock Foreground="#15803D" Text="●" />
                    <TextBlock Margin="6,0,0,0" Foreground="#475569" Text="{Binding StatusText}" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
