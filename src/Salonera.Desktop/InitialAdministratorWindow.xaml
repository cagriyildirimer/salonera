<Window x:Class="Salonera.Desktop.InitialAdministratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Salonera İlk Kurulum" Width="500" Height="600"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}">
    <Border Margin="24" Padding="28" Background="White" CornerRadius="12">
        <StackPanel>
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="İlk yönetici hesabı" />
            <TextBlock Margin="0,6,0,24" Foreground="#64748B" TextWrapping="Wrap"
                       Text="Salonera'yı kullanmaya başlamak için güvenli bir yönetici hesabı oluşturun." />
            <TextBlock Margin="0,0,0,5" FontWeight="SemiBold" Text="Ad soyad" />
            <TextBox Height="36" Padding="9,6" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Margin="0,14,0,5" FontWeight="SemiBold" Text="Kullanıcı adı" />
            <TextBox Height="36" Padding="9,6" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Margin="0,14,0,5" FontWeight="SemiBold" Text="Parola" />
            <PasswordBox x:Name="PasswordInput" Height="36" Padding="9,6" />
            <TextBlock Margin="0,14,0,5" FontWeight="SemiBold" Text="Parola tekrarı" />
            <PasswordBox x:Name="ConfirmationInput" Height="36" Padding="9,6" />
            <TextBlock Margin="0,10,0,0" FontSize="12" Foreground="#64748B" TextWrapping="Wrap"
                       Text="En az 12 karakter; büyük harf, küçük harf, rakam ve özel karakter kullanın." />
            <TextBlock Margin="0,10,0,0" MinHeight="42" Foreground="#B91C1C"
                       TextWrapping="Wrap" Text="{Binding Message}" />
            <Button Height="42" Margin="0,10,0,0" Background="{StaticResource PrimaryBrush}"
                    Foreground="White" FontWeight="SemiBold" Content="Yönetici Hesabını Oluştur"
                    IsDefault="True" Click="CreateClick" />
        </StackPanel>
    </Border>
</Window>
