<Window x:Class="Salonera.Desktop.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Parola Değiştir" Width="460" Height="510"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}">
    <Border Margin="26" Padding="28" Background="White" CornerRadius="12">
        <StackPanel>
            <TextBlock FontSize="23" FontWeight="SemiBold" Text="Parolanızı değiştirin" />
            <TextBlock Margin="0,6,0,22" Foreground="#64748B" TextWrapping="Wrap"
                       Text="Devam etmeden önce yeni ve güvenli bir parola belirlemelisiniz." />
            <TextBlock Margin="0,0,0,5" FontWeight="SemiBold" Text="Mevcut parola" />
            <PasswordBox x:Name="CurrentPasswordInput" Height="36" Padding="9,6" />
            <TextBlock Margin="0,14,0,5" FontWeight="SemiBold" Text="Yeni parola" />
            <PasswordBox x:Name="NewPasswordInput" Height="36" Padding="9,6" />
            <TextBlock Margin="0,14,0,5" FontWeight="SemiBold" Text="Yeni parola tekrarı" />
            <PasswordBox x:Name="ConfirmationInput" Height="36" Padding="9,6" />
            <TextBlock Margin="0,12,0,0" MinHeight="46" Foreground="#B91C1C"
                       TextWrapping="Wrap" Text="{Binding Message}" />
            <Button Height="42" Margin="0,10,0,0" Background="{StaticResource PrimaryBrush}"
                    Foreground="White" FontWeight="SemiBold" Content="Parolayı Değiştir"
                    IsDefault="True" Click="ChangeClick" />
        </StackPanel>
    </Border>
</Window>
