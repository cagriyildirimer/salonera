<UserControl x:Class="Salonera.Desktop.CustomerManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{StaticResource PageBrush}" Loaded="WindowLoaded">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel>
            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Padding="12,6" Content="Seçileni Arşivle" Click="DeleteClick" />
            <Button DockPanel.Dock="Right" Padding="12,6" Content="Ara" Click="SearchClick" />
            <TextBox DockPanel.Dock="Right" Width="240" Margin="0,0,8,0" Padding="8,5"
                     Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="Müşteriler" />
        </DockPanel>
        <Grid Grid.Row="1" Margin="0,18">
            <DataGrid x:Name="CustomersGrid" ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Ad Soyad" Binding="{Binding FullName}" Width="2*" />
                    <DataGridTextColumn Header="Telefon" Binding="{Binding Phone}" Width="*" />
                    <DataGridTextColumn Header="E-posta" Binding="{Binding Email}" Width="2*" />
                    <DataGridTextColumn Header="Gelin" Binding="{Binding BrideName}" Width="*" />
                    <DataGridTextColumn Header="Damat" Binding="{Binding GroomName}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=CustomersGrid}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                <TextBlock Text="♙" FontSize="34" Foreground="#AAA6E5" HorizontalAlignment="Center" />
                <TextBlock Text="Henüz müşteri kaydı yok" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                <TextBlock Text="İlk müşterini aşağıdaki formdan ekleyebilirsin." Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,5,0,0" />
            </StackPanel>
        </Grid>
        <Border Grid.Row="2" Padding="20,16" Background="White" BorderBrush="#E0E8F1" BorderThickness="1" CornerRadius="12">
            <StackPanel>
                <TextBlock Text="Yeni müşteri" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,12" />
                <UniformGrid Columns="3">
                    <StackPanel Margin="0,0,10,10"><TextBlock Text="Ad" Style="{StaticResource FieldLabelStyle}" /><TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    <StackPanel Margin="0,0,10,10"><TextBlock Text="Soyad" Style="{StaticResource FieldLabelStyle}" /><TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    <StackPanel Margin="0,0,0,10"><TextBlock Text="Telefon" Style="{StaticResource FieldLabelStyle}" /><TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    <StackPanel Margin="0,0,10,0"><TextBlock Text="E-posta" Style="{StaticResource FieldLabelStyle}" /><TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    <StackPanel Margin="0,0,10,0"><TextBlock Text="Gelin adı" Style="{StaticResource FieldLabelStyle}" /><TextBox Text="{Binding BrideName, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    <StackPanel><TextBlock Text="Damat adı" Style="{StaticResource FieldLabelStyle}" /><TextBox Text="{Binding GroomName, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                </UniformGrid>
                <DockPanel Margin="0,16,0,0">
                    <Button DockPanel.Dock="Right" Width="140" Background="{StaticResource PrimaryBrush}" Foreground="White" BorderThickness="0" Content="Müşteri Ekle" Click="CreateClick" />
                    <TextBlock VerticalAlignment="Center" Foreground="#475569" Text="{Binding Message}" />
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
