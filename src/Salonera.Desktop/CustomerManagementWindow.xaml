<Window x:Class="Salonera.Desktop.CustomerManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Müşteriler" Width="1000" Height="650" WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBrush}" Loaded="WindowLoaded">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel>
            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Padding="12,6" Content="Seçileni Arşivle" Click="DeleteClick" />
            <Button DockPanel.Dock="Right" Padding="12,6" Content="Ara" Click="SearchClick" />
            <TextBox DockPanel.Dock="Right" Width="240" Margin="0,0,8,0" Padding="8,5"
                     Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="Müşteriler" />
        </DockPanel>
        <DataGrid Grid.Row="1" Margin="0,18" ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Ad Soyad" Binding="{Binding FullName}" Width="2*" />
                <DataGridTextColumn Header="Telefon" Binding="{Binding Phone}" Width="*" />
                <DataGridTextColumn Header="E-posta" Binding="{Binding Email}" Width="2*" />
                <DataGridTextColumn Header="Gelin" Binding="{Binding BrideName}" Width="*" />
                <DataGridTextColumn Header="Damat" Binding="{Binding GroomName}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
        <Border Grid.Row="2" Padding="14" Background="White" CornerRadius="10">
            <StackPanel>
                <UniformGrid Columns="6">
                    <TextBox Margin="4" Padding="7" Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Ad" />
                    <TextBox Margin="4" Padding="7" Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Soyad" />
                    <TextBox Margin="4" Padding="7" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" ToolTip="Telefon" />
                    <TextBox Margin="4" Padding="7" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" ToolTip="E-posta" />
                    <TextBox Margin="4" Padding="7" Text="{Binding BrideName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Gelin adı" />
                    <TextBox Margin="4" Padding="7" Text="{Binding GroomName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Damat adı" />
                </UniformGrid>
                <DockPanel Margin="4,8,4,0">
                    <Button DockPanel.Dock="Right" Width="120" Padding="10,6" Content="Müşteri Ekle" Click="CreateClick" />
                    <TextBlock VerticalAlignment="Center" Foreground="#475569" Text="{Binding Message}" />
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
