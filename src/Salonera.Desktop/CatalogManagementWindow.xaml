<UserControl x:Class="Salonera.Desktop.CatalogManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource PageBrush}" Loaded="WindowLoaded">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock FontSize="24" FontWeight="SemiBold" Text="Şube, Salon ve Organizasyon Türleri" />
        <TabControl Grid.Row="1" Margin="0,18">
            <TabItem Header="Şubeler">
                <Grid Margin="12"><Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DataGrid ItemsSource="{Binding Branches}" SelectedItem="{Binding SelectedBranch}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns><DataGridTextColumn Header="Kod" Binding="{Binding Code}" Width="*" /><DataGridTextColumn Header="Ad" Binding="{Binding Name}" Width="3*" /></DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0" VerticalAlignment="Bottom">
                        <StackPanel Margin="0,0,10,0"><TextBlock Text="Şube kodu" Style="{StaticResource FieldLabelStyle}" /><TextBox Width="140" Text="{Binding BranchCode}" /></StackPanel>
                        <StackPanel Margin="0,0,10,0"><TextBlock Text="Şube adı" Style="{StaticResource FieldLabelStyle}" /><TextBox Width="260" Text="{Binding BranchName}" /></StackPanel>
                        <Button Width="120" VerticalAlignment="Bottom" Background="{StaticResource PrimaryBrush}" Foreground="White" BorderThickness="0" Content="Şube Ekle" Click="CreateBranchClick" />
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Salonlar">
                <Grid Margin="12"><Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DataGrid ItemsSource="{Binding Halls}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns><DataGridTextColumn Header="Kod" Binding="{Binding Code}" Width="*" /><DataGridTextColumn Header="Salon" Binding="{Binding Name}" Width="2*" /><DataGridTextColumn Header="Kapasite" Binding="{Binding Capacity}" Width="*" /></DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0" VerticalAlignment="Bottom">
                        <StackPanel Margin="0,0,10,0"><TextBlock Text="Şube" Style="{StaticResource FieldLabelStyle}" /><ComboBox Width="180" ItemsSource="{Binding Branches}" SelectedItem="{Binding SelectedBranch}" DisplayMemberPath="Name" /></StackPanel>
                        <StackPanel Margin="0,0,10,0"><TextBlock Text="Salon kodu" Style="{StaticResource FieldLabelStyle}" /><TextBox Width="110" Text="{Binding HallCode}" /></StackPanel>
                        <StackPanel Margin="0,0,10,0"><TextBlock Text="Salon adı" Style="{StaticResource FieldLabelStyle}" /><TextBox Width="180" Text="{Binding HallName}" /></StackPanel>
                        <StackPanel Margin="0,0,10,0"><TextBlock Text="Kapasite" Style="{StaticResource FieldLabelStyle}" /><TextBox Width="90" Text="{Binding Capacity}" /></StackPanel>
                        <Button Width="120" VerticalAlignment="Bottom" Background="{StaticResource PrimaryBrush}" Foreground="White" BorderThickness="0" Content="Salon Ekle" Click="CreateHallClick" />
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Organizasyon Türleri">
                <Grid Margin="12"><Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DataGrid ItemsSource="{Binding EventTypes}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns><DataGridTextColumn Header="Organizasyon Türü" Binding="{Binding Name}" Width="*" /></DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                        <StackPanel Margin="0,0,10,0"><TextBlock Text="Organizasyon türü" Style="{StaticResource FieldLabelStyle}" /><TextBox Width="300" Text="{Binding EventTypeName}" /></StackPanel>
                        <Button Width="120" VerticalAlignment="Bottom" Background="{StaticResource PrimaryBrush}" Foreground="White" BorderThickness="0" Content="Tür Ekle" Click="CreateEventTypeClick" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
        <TextBlock Grid.Row="2" Foreground="#475569" Text="{Binding Message}" />
    </Grid>
</UserControl>
