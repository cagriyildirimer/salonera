<Window x:Class="Salonera.Desktop.CatalogManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Şube, Salon ve Organizasyon Türleri" Width="900" Height="620"
        WindowStartupLocation="CenterOwner" Background="{StaticResource PageBrush}" Loaded="WindowLoaded">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock FontSize="24" FontWeight="SemiBold" Text="Şube, Salon ve Organizasyon Türleri" />
        <TabControl Grid.Row="1" Margin="0,18">
            <TabItem Header="Şubeler">
                <Grid Margin="12"><Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DataGrid ItemsSource="{Binding Branches}" SelectedItem="{Binding SelectedBranch}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns><DataGridTextColumn Header="Kod" Binding="{Binding Code}" Width="*" /><DataGridTextColumn Header="Ad" Binding="{Binding Name}" Width="3*" /></DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBox Width="140" Margin="0,0,8,0" Padding="7" Text="{Binding BranchCode}" ToolTip="Şube kodu" />
                        <TextBox Width="260" Margin="0,0,8,0" Padding="7" Text="{Binding BranchName}" ToolTip="Şube adı" />
                        <Button Width="100" Content="Şube Ekle" Click="CreateBranchClick" />
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Salonlar">
                <Grid Margin="12"><Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DataGrid ItemsSource="{Binding Halls}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns><DataGridTextColumn Header="Kod" Binding="{Binding Code}" Width="*" /><DataGridTextColumn Header="Salon" Binding="{Binding Name}" Width="2*" /><DataGridTextColumn Header="Kapasite" Binding="{Binding Capacity}" Width="*" /></DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                        <ComboBox Width="180" Margin="0,0,8,0" ItemsSource="{Binding Branches}" SelectedItem="{Binding SelectedBranch}" DisplayMemberPath="Name" />
                        <TextBox Width="110" Margin="0,0,8,0" Padding="7" Text="{Binding HallCode}" ToolTip="Salon kodu" />
                        <TextBox Width="180" Margin="0,0,8,0" Padding="7" Text="{Binding HallName}" ToolTip="Salon adı" />
                        <TextBox Width="90" Margin="0,0,8,0" Padding="7" Text="{Binding Capacity}" ToolTip="Kapasite" />
                        <Button Width="100" Content="Salon Ekle" Click="CreateHallClick" />
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Organizasyon Türleri">
                <Grid Margin="12"><Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DataGrid ItemsSource="{Binding EventTypes}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns><DataGridTextColumn Header="Organizasyon Türü" Binding="{Binding Name}" Width="*" /></DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBox Width="300" Margin="0,0,8,0" Padding="7" Text="{Binding EventTypeName}" />
                        <Button Width="110" Content="Tür Ekle" Click="CreateEventTypeClick" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
        <TextBlock Grid.Row="2" Foreground="#475569" Text="{Binding Message}" />
    </Grid>
</Window>
