<UserControl x:Class="Salonera.Desktop.UserManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource PageBrush}"
        Loaded="WindowLoaded">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel>
            <Button DockPanel.Dock="Right" Padding="12,6" Content="Aktif/Pasif Değiştir"
                    Click="ToggleActiveClick" />
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="Kullanıcı Yönetimi" />
        </DockPanel>
        <DataGrid Grid.Row="1" Margin="0,18" ItemsSource="{Binding Users}"
                  SelectedItem="{Binding SelectedUser}" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Ad Soyad" Binding="{Binding DisplayName}" Width="2*" />
                <DataGridTextColumn Header="Kullanıcı Adı" Binding="{Binding Username}" Width="*" />
                <DataGridTextColumn Header="Roller" Binding="{Binding Roles}" Width="*" />
                <DataGridCheckBoxColumn Header="Aktif" Binding="{Binding IsActive}" Width="80" />
            </DataGrid.Columns>
        </DataGrid>
        <Border Grid.Row="2" Padding="20,16" Background="White" BorderBrush="#E0E8F1" BorderThickness="1" CornerRadius="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Margin="0,0,0,4" Text="Ad soyad" />
                    <TextBox Height="34" Padding="8,5" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Margin="0,0,0,4" Text="Kullanıcı adı" />
                    <TextBox Height="34" Padding="8,5" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <TextBlock Margin="0,0,0,4" Text="Geçici parola" />
                    <PasswordBox x:Name="PasswordInput" Height="34" Padding="8,5" />
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,10,0">
                    <TextBlock Margin="0,0,0,4" Text="Rol" />
                    <ComboBox Height="34" ItemsSource="{Binding RoleOptions}" DisplayMemberPath="Name"
                              SelectedValuePath="Code" SelectedValue="{Binding SelectedRoleCode}" />
                </StackPanel>
                <Button Grid.Column="4" Width="100" Height="34" VerticalAlignment="Bottom"
                        Background="{StaticResource PrimaryBrush}" Foreground="White"
                        Content="Kullanıcı Ekle" Click="CreateClick" />
            </Grid>
        </Border>
        <TextBlock Grid.Row="3" Margin="16,8,16,0" Foreground="#475569"
                   Text="{Binding Message}" />
    </Grid>
</UserControl>
