<Window x:Class="Salonera.Desktop.SalesContractWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paketler ve Sözleşme" Width="1050" Height="690"
        WindowStartupLocation="CenterOwner" Background="{StaticResource PageBrush}" Loaded="WindowLoaded">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock FontSize="24" FontWeight="SemiBold" Text="Paketler, Hizmetler ve Sözleşme" />
        <TabControl Grid.Row="1" Margin="0,18">
            <TabItem Header="Paketler ve Hizmetler">
                <Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Grid Margin="0,0,10,0"><Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <DataGrid ItemsSource="{Binding Packages}" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns><DataGridTextColumn Header="Paket" Binding="{Binding Name}" Width="2*" /><DataGridTextColumn Header="Satış" Binding="{Binding SalesPrice, StringFormat=N2}" Width="*" /><DataGridTextColumn Header="Maliyet" Binding="{Binding CostPrice, StringFormat=N2}" Width="*" /></DataGrid.Columns>
                        </DataGrid>
                        <UniformGrid Grid.Row="1" Columns="5" Margin="0,10,0,0">
                            <TextBox Margin="3" Text="{Binding PackageName}" ToolTip="Paket adı" />
                            <TextBox Margin="3" Text="{Binding IncludedGuests}" ToolTip="Kişi sayısı" />
                            <TextBox Margin="3" Text="{Binding PackageSalesPrice}" ToolTip="Satış fiyatı" />
                            <TextBox Margin="3" Text="{Binding PackageCostPrice}" ToolTip="Maliyet" />
                            <Button Margin="3" Content="Paket Ekle" Click="CreatePackageClick" />
                        </UniformGrid>
                    </Grid>
                    <Grid Grid.Column="1" Margin="10,0,0,0"><Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <DataGrid ItemsSource="{Binding ExtraServices}" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns><DataGridTextColumn Header="Ek Hizmet" Binding="{Binding Name}" Width="2*" /><DataGridTextColumn Header="Satış" Binding="{Binding SalesPrice, StringFormat=N2}" Width="*" /></DataGrid.Columns>
                        </DataGrid>
                        <UniformGrid Grid.Row="1" Columns="4" Margin="0,10,0,0">
                            <TextBox Margin="3" Text="{Binding ExtraName}" ToolTip="Hizmet adı" />
                            <TextBox Margin="3" Text="{Binding ExtraSalesPrice}" ToolTip="Satış fiyatı" />
                            <TextBox Margin="3" Text="{Binding ExtraCostPrice}" ToolTip="Maliyet" />
                            <Button Margin="3" Content="Hizmet Ekle" Click="CreateExtraClick" />
                        </UniformGrid>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Sözleşme Oluştur">
                <Grid Margin="14"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Margin="0,0,0,5" FontWeight="SemiBold" Text="Organizasyon" />
                        <ComboBox Height="36" ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent}" DisplayMemberPath="EventNumber" />
                        <TextBlock Margin="0,16,0,5" FontWeight="SemiBold" Text="Paket" />
                        <ComboBox Height="36" ItemsSource="{Binding Packages}" SelectedItem="{Binding SelectedPackage}" DisplayMemberPath="Name" />
                        <TextBlock Margin="0,16,0,5" FontWeight="SemiBold" Text="Ek hizmetler" />
                        <ListBox x:Name="ExtraServicesInput" Height="210" ItemsSource="{Binding ExtraServices}" DisplayMemberPath="Name" SelectionMode="Multiple" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="26,0,0,0">
                        <TextBlock Margin="0,0,0,5" Text="İndirim" /><TextBox Height="34" Padding="7" Text="{Binding Discount}" />
                        <TextBlock Margin="0,14,0,5" Text="KDV oranı (%)" /><TextBox Height="34" Padding="7" Text="{Binding VatRate}" />
                        <TextBlock Margin="0,14,0,5" Text="Para birimi" /><ComboBox Height="34" ItemsSource="{Binding Currencies}" SelectedItem="{Binding Currency}" />
                        <TextBlock Margin="0,14,0,5" Text="Döviz kuru" /><TextBox Height="34" Padding="7" Text="{Binding ExchangeRate}" />
                        <Button Height="42" Margin="0,22,0,0" Background="{StaticResource PrimaryBrush}" Foreground="White" Content="Sözleşme ve PDF Oluştur" Click="CreateContractClick" />
                        <Button Height="36" Margin="0,8,0,0" Content="PDF'yi Aç" Click="OpenPdfClick" />
                        <Button Height="36" Margin="0,8,0,0" Content="Yazdır" Click="PrintPdfClick" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
        <TextBlock Grid.Row="2" Foreground="#475569" Text="{Binding Message}" />
    </Grid>
</Window>
