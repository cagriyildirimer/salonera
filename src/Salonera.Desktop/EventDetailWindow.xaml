<Window x:Class="Salonera.Desktop.EventDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Organizasyon Detayı" Width="520" Height="480" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource PageBrush}">
    <Border Margin="24" Padding="26" Background="White" CornerRadius="12">
        <StackPanel>
            <TextBlock FontSize="23" FontWeight="SemiBold" Text="Organizasyon Detayı" />
            <TextBlock Margin="0,4,0,22" Foreground="#64748B" Text="{Binding EventNumber}" />
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="38" /><RowDefinition Height="38" /><RowDefinition Height="38" />
                    <RowDefinition Height="38" /><RowDefinition Height="38" /><RowDefinition Height="38" />
                </Grid.RowDefinitions>
                <TextBlock Foreground="#64748B" Text="Müşteri" /><TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding CustomerName}" />
                <TextBlock Grid.Row="1" Foreground="#64748B" Text="Salon" /><TextBlock Grid.Row="1" Grid.Column="1" FontWeight="SemiBold" Text="{Binding HallName}" />
                <TextBlock Grid.Row="2" Foreground="#64748B" Text="Organizasyon türü" /><TextBlock Grid.Row="2" Grid.Column="1" FontWeight="SemiBold" Text="{Binding EventTypeName}" />
                <TextBlock Grid.Row="3" Foreground="#64748B" Text="Başlangıç" /><TextBlock Grid.Row="3" Grid.Column="1" FontWeight="SemiBold" Text="{Binding StartsAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" />
                <TextBlock Grid.Row="4" Foreground="#64748B" Text="Bitiş" /><TextBlock Grid.Row="4" Grid.Column="1" FontWeight="SemiBold" Text="{Binding EndsAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" />
                <TextBlock Grid.Row="5" Foreground="#64748B" Text="Durum" /><TextBlock Grid.Row="5" Grid.Column="1" FontWeight="SemiBold" Text="{Binding Status}" />
            </Grid>
            <Button Margin="0,22,0,0" Height="38" Content="Kapat" IsCancel="True" />
        </StackPanel>
    </Border>
</Window>
