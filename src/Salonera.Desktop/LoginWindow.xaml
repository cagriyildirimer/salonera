<UserControl x:Class="Salonera.Desktop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{StaticResource PageBrush}">
    <Border Margin="28" Padding="30" Background="White" CornerRadius="12">
        <StackPanel>
            <TextBlock FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="Salonera" />
            <TextBlock Margin="0,4,0,28" Foreground="#64748B" Text="Hesabınızla giriş yapın" />
            <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="Kullanıcı adı" />
            <TextBox Height="38" Padding="10,7" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Margin="0,18,0,6" FontWeight="SemiBold" Text="Parola" />
            <PasswordBox x:Name="PasswordInput" Height="38" Padding="10,7" />
            <TextBlock Margin="0,14,0,0" MinHeight="38" Foreground="#B91C1C"
                       TextWrapping="Wrap" Text="{Binding Message}" />
            <Button Height="42" Margin="0,14,0,0" Background="{StaticResource PrimaryBrush}"
                    Foreground="White" FontWeight="SemiBold" Content="Giriş Yap"
                    IsDefault="True" Click="LoginClick" />
        </StackPanel>
    </Border>
</UserControl>
