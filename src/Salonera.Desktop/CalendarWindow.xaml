<Window x:Class="Salonera.Desktop.CalendarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Takvim ve Salon Müsaitliği" Width="1100" Height="680"
        WindowStartupLocation="CenterOwner" Background="{StaticResource PageBrush}" Loaded="WindowLoaded">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <DockPanel>
            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Padding="12,6" Content="Seçileni İptal Et" Click="CancelClick" />
            <Button DockPanel.Dock="Right" Padding="12,6" Content="Yenile" Click="RefreshClick" />
            <ComboBox DockPanel.Dock="Right" Width="100" Margin="0,0,8,0"
                      ItemsSource="{Binding RangeModes}" SelectedItem="{Binding SelectedRangeMode}" />
            <DatePicker DockPanel.Dock="Right" Width="140" Margin="0,0,8,0" SelectedDate="{Binding CalendarDate}" />
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="Takvim ve Salon Müsaitliği" />
        </DockPanel>
        <DataGrid Grid.Row="1" Margin="0,18" ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  MouseDoubleClick="EventDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="No" Binding="{Binding EventNumber}" Width="*" />
                <DataGridTextColumn Header="Başlangıç" Binding="{Binding StartsAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="*" />
                <DataGridTextColumn Header="Bitiş" Binding="{Binding EndsAt, StringFormat={}{0:HH:mm}}" Width="80" />
                <DataGridTextColumn Header="Salon" Binding="{Binding HallName}" Width="*" />
                <DataGridTextColumn Header="Müşteri" Binding="{Binding CustomerName}" Width="2*" />
                <DataGridTextColumn Header="Tür" Binding="{Binding EventTypeName}" Width="*" />
                <DataGridTextColumn Header="Durum" Binding="{Binding Status}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
        <Border Grid.Row="2" Padding="14" Background="White" CornerRadius="10">
            <StackPanel>
                <UniformGrid Columns="8">
                    <ComboBox Margin="4" ItemsSource="{Binding Halls}" SelectedItem="{Binding SelectedHall}" DisplayMemberPath="Name" />
                    <ComboBox Margin="4" ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" DisplayMemberPath="FullName" />
                    <ComboBox Margin="4" ItemsSource="{Binding EventTypes}" SelectedItem="{Binding SelectedEventType}" DisplayMemberPath="Name" />
                    <DatePicker Margin="4" SelectedDate="{Binding EventDate}" />
                    <TextBox Margin="4" Padding="7" Text="{Binding StartTime}" ToolTip="Başlangıç saati" />
                    <TextBox Margin="4" Padding="7" Text="{Binding EndTime}" ToolTip="Bitiş saati" />
                    <TextBox Margin="4" Padding="7" Text="{Binding GuestCount}" ToolTip="Davetli sayısı" />
                    <ComboBox Margin="4" ItemsSource="{Binding Statuses}" SelectedItem="{Binding Status}" />
                </UniformGrid>
                <DockPanel Margin="4,8,4,0">
                    <Button DockPanel.Dock="Right" Width="140" Padding="10,6" Content="Takvime Ekle" Click="ScheduleClick" />
                    <TextBlock VerticalAlignment="Center" Foreground="#475569" Text="{Binding Message}" />
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
