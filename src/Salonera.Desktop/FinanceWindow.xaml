<UserControl x:Class="Salonera.Desktop.FinanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource PageBrush}"
        Loaded="WindowLoaded">
    <UserControl.Resources>
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,11,0,4" />
            <Setter Property="Foreground" Value="#475569" />
        </Style>
        <Style x:Key="FormText" TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="7" />
        </Style>
        <Style x:Key="FormCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="34" />
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="0,12,0,0" />
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Padding="14,7" Content="Yenile" Click="RefreshClick" />
            <StackPanel>
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="Finans ve Cari Hesaplar" />
                <TextBlock Foreground="#64748B" Text="Gelir, gider, tedarikçi ve hesap hareketleri" />
            </StackPanel>
        </DockPanel>
        <TabControl Grid.Row="1">
            <TabItem Header="Kasa, Banka ve Virman">
                <Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid Margin="0,0,16,0"><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <GroupBox Header="Hesaplar" Padding="8">
                            <DataGrid ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" SelectionChanged="AccountChanged" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tür" Binding="{Binding TypeText}" Width="70" />
                                    <DataGridTextColumn Header="Kod" Binding="{Binding Code}" Width="100" />
                                    <DataGridTextColumn Header="Hesap" Binding="{Binding Name}" Width="2*" />
                                    <DataGridTextColumn Header="Para" Binding="{Binding CurrencyText}" Width="70" />
                                    <DataGridTextColumn Header="Bakiye" Binding="{Binding Balance, StringFormat=N2}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                        <GroupBox Grid.Row="1" Header="Seçili hesabın hareketleri" Margin="0,12,0,0" Padding="8">
                            <DataGrid ItemsSource="{Binding Movements}" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tarih" Binding="{Binding Date, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="130" />
                                    <DataGridTextColumn Header="İşlem" Binding="{Binding TypeText}" Width="130" />
                                    <DataGridTextColumn Header="Tutar" Binding="{Binding Amount, StringFormat=N2}" Width="100" />
                                    <DataGridTextColumn Header="Açıklama" Binding="{Binding Description}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                    </Grid>
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" IsEnabled="{Binding CanManageFinance}">
                        <StackPanel>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Yeni hesap" />
                            <TextBlock Style="{StaticResource FormLabel}" Text="Tür / para birimi" />
                            <UniformGrid Columns="2"><ComboBox Margin="0,0,5,0" Style="{StaticResource FormCombo}" ItemsSource="{Binding AccountTypes}" DisplayMemberPath="Name" SelectedItem="{Binding AccountForm.Type}" /><ComboBox Margin="5,0,0,0" Style="{StaticResource FormCombo}" ItemsSource="{Binding Currencies}" DisplayMemberPath="Name" SelectedItem="{Binding AccountForm.Currency}" /></UniformGrid>
                            <TextBlock Style="{StaticResource FormLabel}" Text="Hesap kodu" /><TextBox Style="{StaticResource FormText}" Text="{Binding AccountForm.Code}" />
                            <TextBlock Style="{StaticResource FormLabel}" Text="Hesap adı" /><TextBox Style="{StaticResource FormText}" Text="{Binding AccountForm.Name}" />
                            <TextBlock Style="{StaticResource FormLabel}" Text="Açılış bakiyesi" /><TextBox Style="{StaticResource FormText}" Text="{Binding AccountForm.OpeningBalance}" />
                            <TextBlock Style="{StaticResource FormLabel}" Text="Banka adı (banka hesabı için)" /><TextBox Style="{StaticResource FormText}" Text="{Binding AccountForm.BankName}" />
                            <TextBlock Style="{StaticResource FormLabel}" Text="IBAN (isteğe bağlı)" /><TextBox Style="{StaticResource FormText}" Text="{Binding AccountForm.Iban}" />
                            <Button Style="{StaticResource ActionButton}" Content="Hesap Oluştur" Click="CreateAccountClick" />
                            <Separator Margin="0,20" />
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Hesaplar arası virman" />
                            <TextBlock Style="{StaticResource FormLabel}" Text="Kaynak hesap" /><ComboBox Style="{StaticResource FormCombo}" ItemsSource="{Binding Accounts}" DisplayMemberPath="DisplayName" SelectedItem="{Binding TransferForm.From}" />
                            <TextBlock Style="{StaticResource FormLabel}" Text="Hedef hesap" /><ComboBox Style="{StaticResource FormCombo}" ItemsSource="{Binding Accounts}" DisplayMemberPath="DisplayName" SelectedItem="{Binding TransferForm.To}" />
                            <TextBlock Style="{StaticResource FormLabel}" Text="Tutar / kur" /><UniformGrid Columns="2"><TextBox Margin="0,0,5,0" Style="{StaticResource FormText}" Text="{Binding TransferForm.Amount}" /><TextBox Margin="5,0,0,0" Style="{StaticResource FormText}" Text="{Binding TransferForm.ExchangeRate}" /></UniformGrid>
                            <TextBlock Style="{StaticResource FormLabel}" Text="Açıklama" /><TextBox Style="{StaticResource FormText}" Text="{Binding TransferForm.Description}" />
                            <Button Style="{StaticResource ActionButton}" Content="Virman Yap" Click="TransferClick" />
                            <TextBlock Style="{StaticResource FormLabel}" Text="Virman geçmişi" />
                            <DataGrid Height="150" ItemsSource="{Binding Transfers}" SelectedItem="{Binding SelectedTransfer}" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns><DataGridTextColumn Header="Kaynak" Binding="{Binding FromAccount}" Width="*" /><DataGridTextColumn Header="Hedef" Binding="{Binding ToAccount}" Width="*" /><DataGridTextColumn Header="Tutar" Binding="{Binding Amount, StringFormat=N2}" Width="80" /><DataGridCheckBoxColumn Header="İptal" Binding="{Binding IsCancelled}" Width="55" /></DataGrid.Columns>
                            </DataGrid>
                            <Button Height="34" Margin="0,8,0,0" Content="Seçili Virmanı İptal Et" Click="CancelTransferClick" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Header="Gelirler">
                <Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <DataGrid Margin="0,0,16,0" ItemsSource="{Binding Incomes}" SelectedItem="{Binding SelectedIncome}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns><DataGridTextColumn Header="Tarih" Binding="{Binding Date, StringFormat={}{0:dd.MM.yyyy}}" Width="90" /><DataGridTextColumn Header="Kategori" Binding="{Binding Category}" Width="*" /><DataGridTextColumn Header="Tutar" Binding="{Binding Amount, StringFormat=N2}" Width="100" /><DataGridTextColumn Header="Para" Binding="{Binding CurrencyText}" Width="60" /><DataGridTextColumn Header="Açıklama" Binding="{Binding Description}" Width="2*" /><DataGridCheckBoxColumn Header="İptal" Binding="{Binding IsCancelled}" Width="55" /></DataGrid.Columns>
                    </DataGrid>
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" IsEnabled="{Binding CanManageFinance}"><StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Yeni gelir" />
                        <TextBlock Style="{StaticResource FormLabel}" Text="Kategori" /><ComboBox Style="{StaticResource FormCombo}" ItemsSource="{Binding IncomeCategories}" DisplayMemberPath="Name" SelectedItem="{Binding IncomeForm.Category}" />
                        <DockPanel Margin="0,6,0,0"><Button DockPanel.Dock="Right" Width="65" Content="Ekle" Click="CreateIncomeCategoryClick" /><TextBox Margin="0,0,6,0" Style="{StaticResource FormText}" Text="{Binding NewIncomeCategory}" ToolTip="Yeni kategori adı" /></DockPanel>
                        <TextBlock Style="{StaticResource FormLabel}" Text="Hesap" /><ComboBox Style="{StaticResource FormCombo}" ItemsSource="{Binding Accounts}" DisplayMemberPath="DisplayName" SelectedItem="{Binding IncomeForm.Account}" />
                        <TextBlock Style="{StaticResource FormLabel}" Text="KDV dahil tutar / kur" /><UniformGrid Columns="2"><TextBox Margin="0,0,5,0" Style="{StaticResource FormText}" Text="{Binding IncomeForm.Amount}" /><TextBox Margin="5,0,0,0" Style="{StaticResource FormText}" Text="{Binding IncomeForm.ExchangeRate}" /></UniformGrid>
                        <TextBlock Style="{StaticResource FormLabel}" Text="KDV oranı (%)" /><TextBox Style="{StaticResource FormText}" Text="{Binding IncomeForm.VatRate}" />
                        <TextBlock Style="{StaticResource FormLabel}" Text="Organizasyon (isteğe bağlı)" /><ComboBox Style="{StaticResource FormCombo}" ItemsSource="{Binding Events}" DisplayMemberPath="EventNumber" SelectedItem="{Binding IncomeForm.Event}" />
                        <TextBlock Style="{StaticResource FormLabel}" Text="Müşteri (isteğe bağlı)" /><ComboBox Style="{StaticResource FormCombo}" ItemsSource="{Binding Customers}" DisplayMemberPath="FullName" SelectedItem="{Binding IncomeForm.Customer}" />
                        <TextBlock Style="{StaticResource FormLabel}" Text="Belge no" /><TextBox Style="{StaticResource FormText}" Text="{Binding IncomeForm.DocumentNumber}" />
                        <TextBlock Style="{StaticResource FormLabel}" Text="Açıklama" /><TextBox Style="{StaticResource FormText}" Text="{Binding IncomeForm.Description}" />
                        <Button Style="{StaticResource ActionButton}" Content="Geliri Kaydet" Click="CreateIncomeClick" />
                        <Separator Margin="0,20" />
                        <TextBlock Style="{StaticResource FormLabel}" Text="İptal nedeni" /><TextBox Style="{StaticResource FormText}" Text="{Binding CancelReason}" />
                        <Button Height="34" Margin="0,8,0,0" Content="Seçili Geliri İptal Et" Click="CancelIncomeClick" />
                    </StackPanel></ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Header="Giderler">
                <Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <DataGrid Margin="0,0,16,0" ItemsSource="{Binding Expenses}" SelectedItem="{Binding SelectedExpense}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns><DataGridTextColumn Header="Tarih" Binding="{Binding Date, StringFormat={}{0:dd.MM.yyyy}}" Width="85" /><DataGridTextColumn Header="Kategori" Binding="{Binding Category}" Width="*" /><DataGridTextColumn Header="Tutar" Binding="{Binding Amount, StringFormat=N2}" Width="95" /><DataGridTextColumn Header="Ödenen" Binding="{Binding PaidAmount, StringFormat=N2}" Width="95" /><DataGridTextColumn Header="Tedarikçi" Binding="{Binding Supplier}" Width="*" /><DataGridTextColumn Header="Organizasyon" Binding="{Binding EventNumber}" Width="110" /><DataGridTextColumn Header="Durum" Binding="{Binding StatusText}" Width="100" /></DataGrid.Columns>
                    </DataGrid>
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" IsEnabled="{Binding CanManageFinance}"><StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Yeni gider" />
                        <TextBlock Style="{StaticResource FormLabel}" Text="Kategori" /><ComboBox Style="{StaticResource FormCombo}" ItemsSource="{Binding ExpenseCategories}" DisplayMemberPath="Name" SelectedItem="{Binding ExpenseForm.Category}" />
                        <DockPanel Margin="0,6,0,0"><Button DockPanel.Dock="Right" Width="65" Content="Ekle" Click="CreateExpenseCategoryClick" /><TextBox Margin="0,0,6,0" Style="{StaticResource FormText}" Text="{Binding NewExpenseCategory}" ToolTip="Yeni kategori adı" /></DockPanel>
                        <TextBlock Style="{StaticResource FormLabel}" Text="Tedarikçi (isteğe bağlı)" /><ComboBox Style="{StaticResource FormCombo}" ItemsSource="{Binding Suppliers}" DisplayMemberPath="Name" SelectedItem="{Binding ExpenseForm.Supplier}" />
                        <TextBlock Style="{StaticResource FormLabel}" Text="Organizasyon (isteğe bağlı)" /><ComboBox Style="{StaticResource FormCombo}" ItemsSource="{Binding Events}" DisplayMemberPath="EventNumber" SelectedItem="{Binding ExpenseForm.Event}" />
                        <TextBlock Style="{StaticResource FormLabel}" Text="Para birimi" /><ComboBox Style="{StaticResource FormCombo}" ItemsSource="{Binding Currencies}" DisplayMemberPath="Name" SelectedItem="{Binding ExpenseForm.Currency}" />
                        <TextBlock Style="{StaticResource FormLabel}" Text="KDV dahil tutar / kur" /><UniformGrid Columns="2"><TextBox Margin="0,0,5,0" Style="{StaticResource FormText}" Text="{Binding ExpenseForm.Amount}" /><TextBox Margin="5,0,0,0" Style="{StaticResource FormText}" Text="{Binding ExpenseForm.ExchangeRate}" /></UniformGrid>
                        <TextBlock Style="{StaticResource FormLabel}" Text="KDV oranı (%)" /><TextBox Style="{StaticResource FormText}" Text="{Binding ExpenseForm.VatRate}" />
                        <TextBlock Style="{StaticResource FormLabel}" Text="Vade" /><DatePicker SelectedDate="{Binding ExpenseForm.DueDate}" />
                        <TextBlock Style="{StaticResource FormLabel}" Text="Belge no" /><TextBox Style="{StaticResource FormText}" Text="{Binding ExpenseForm.DocumentNumber}" />
                        <TextBlock Style="{StaticResource FormLabel}" Text="Açıklama" /><TextBox Style="{StaticResource FormText}" Text="{Binding ExpenseForm.Description}" />
                        <CheckBox Margin="0,10,0,0" Content="Tekrarlayan gider" IsChecked="{Binding ExpenseForm.IsRecurring}" />
                        <Button Style="{StaticResource ActionButton}" Content="Gideri Kaydet" Click="CreateExpenseClick" />
                        <Separator Margin="0,20" />
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Seçili gideri öde" />
                        <TextBlock Style="{StaticResource FormLabel}" Text="Ödeme hesabı" /><ComboBox Style="{StaticResource FormCombo}" ItemsSource="{Binding Accounts}" DisplayMemberPath="DisplayName" SelectedItem="{Binding ExpensePaymentAccount}" />
                        <TextBlock Style="{StaticResource FormLabel}" Text="Ödenecek tutar" /><TextBox Style="{StaticResource FormText}" Text="{Binding ExpensePaymentAmount}" />
                        <Button Style="{StaticResource ActionButton}" Content="Ödemeyi Kaydet" Click="PayExpenseClick" />
                        <TextBlock Style="{StaticResource FormLabel}" Text="İptal nedeni" /><TextBox Style="{StaticResource FormText}" Text="{Binding CancelReason}" />
                        <Button Height="34" Margin="0,8,0,0" Content="Seçili Gideri İptal Et" Click="CancelExpenseClick" />
                    </StackPanel></ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Header="Tedarikçiler ve Maliyetler">
                <Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid Margin="0,0,16,0"><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="*" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <GroupBox Header="Tedarikçiler" Padding="8"><DataGrid ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}" SelectionChanged="SupplierChanged" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns><DataGridTextColumn Header="Ad" Binding="{Binding Name}" Width="2*" /><DataGridTextColumn Header="Telefon" Binding="{Binding Phone}" Width="*" /><DataGridTextColumn Header="Cari bakiye (TRY)" Binding="{Binding BalanceTry, StringFormat=N2}" Width="*" /></DataGrid.Columns>
                        </DataGrid></GroupBox>
                        <GroupBox Grid.Row="1" Header="Seçili tedarikçinin cari hareketleri" Padding="8" Margin="0,10,0,0"><DataGrid ItemsSource="{Binding SupplierMovements}" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns><DataGridTextColumn Header="Tarih" Binding="{Binding Date, StringFormat={}{0:dd.MM.yyyy}}" Width="100" /><DataGridTextColumn Header="Borç azaltan" Binding="{Binding Debit, StringFormat=N2}" Width="100" /><DataGridTextColumn Header="Borç artıran" Binding="{Binding Credit, StringFormat=N2}" Width="100" /><DataGridTextColumn Header="Açıklama" Binding="{Binding Description}" Width="*" /></DataGrid.Columns>
                        </DataGrid></GroupBox>
                        <GroupBox Grid.Row="2" Header="Organizasyon maliyetleri (TRY)" Padding="8" Margin="0,10,0,0"><DataGrid ItemsSource="{Binding EventCosts}" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns><DataGridTextColumn Header="Organizasyon" Binding="{Binding EventNumber}" Width="*" /><DataGridTextColumn Header="Paket/Hizmet" Binding="{Binding ServiceCostTry, StringFormat=N2}" Width="100" /><DataGridTextColumn Header="Diğer gider" Binding="{Binding DirectExpenseTry, StringFormat=N2}" Width="100" /><DataGridTextColumn Header="Toplam" Binding="{Binding TotalCostTry, StringFormat=N2}" Width="110" /></DataGrid.Columns>
                        </DataGrid></GroupBox>
                    </Grid>
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" IsEnabled="{Binding CanManageFinance}"><StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Yeni tedarikçi" />
                        <TextBlock Style="{StaticResource FormLabel}" Text="Ad" /><TextBox Style="{StaticResource FormText}" Text="{Binding SupplierForm.Name}" />
                        <TextBlock Style="{StaticResource FormLabel}" Text="Yetkili kişi" /><TextBox Style="{StaticResource FormText}" Text="{Binding SupplierForm.ContactPerson}" />
                        <TextBlock Style="{StaticResource FormLabel}" Text="Telefon" /><TextBox Style="{StaticResource FormText}" Text="{Binding SupplierForm.Phone}" />
                        <TextBlock Style="{StaticResource FormLabel}" Text="E-posta" /><TextBox Style="{StaticResource FormText}" Text="{Binding SupplierForm.Email}" />
                        <TextBlock Style="{StaticResource FormLabel}" Text="Vergi dairesi" /><TextBox Style="{StaticResource FormText}" Text="{Binding SupplierForm.TaxOffice}" />
                        <TextBlock Style="{StaticResource FormLabel}" Text="Vergi no" /><TextBox Style="{StaticResource FormText}" Text="{Binding SupplierForm.TaxNumber}" />
                        <TextBlock Style="{StaticResource FormLabel}" Text="Adres" /><TextBox Height="70" TextWrapping="Wrap" AcceptsReturn="True" Padding="7" Text="{Binding SupplierForm.Address}" />
                        <TextBlock Style="{StaticResource FormLabel}" Text="Banka bilgisi" /><TextBox Style="{StaticResource FormText}" Text="{Binding SupplierForm.BankInformation}" />
                        <Button Style="{StaticResource ActionButton}" Content="Tedarikçi Oluştur" Click="CreateSupplierClick" />
                    </StackPanel></ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
        <TextBlock Grid.Row="2" Margin="0,10,0,0" Foreground="#B91C1C" Text="{Binding Message}" TextWrapping="Wrap" />
    </Grid>
</UserControl>
